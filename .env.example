# No incluir secretos reales en este archivo.

# Database — usadas por docker-compose.yml para inicializar el contenedor de PostgreSQL
POSTGRES_USER=sentinel_app
POSTGRES_PASSWORD=
POSTGRES_DB=bd_gabriela_rincon_nakamoto

# Cadena de conexión ADMIN (rol superusuario del contenedor) — solo para migrar/seedear y
# para .mcp.json. La aplicación NUNCA usa esta cadena en tiempo de ejecución.
DATABASE_URL=postgresql://sentinel_app:<TU_PASSWORD>@localhost:5434/bd_gabriela_rincon_nakamoto

# Rol de aplicación (rw_app): sin SUPERUSER, sin BYPASSRLS (Fase 4). El backend usa
# RW_APP_DATABASE_URL para todas sus consultas en tiempo de ejecución.
RW_APP_PASSWORD=
RW_APP_DATABASE_URL=postgresql://rw_app:<TU_PASSWORD>@localhost:5434/bd_gabriela_rincon_nakamoto

# Auth
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# CORS (Fase 17) — orígenes del frontend permitidos, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# LLM / Embeddings provider
LLM_API_KEY=
EMBEDDING_API_KEY=
