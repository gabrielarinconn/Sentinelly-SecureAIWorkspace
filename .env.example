# No incluir secretos reales en este archivo.

# Database — usadas por docker-compose.yml para inicializar el contenedor de PostgreSQL
POSTGRES_USER=sentinel_app
POSTGRES_PASSWORD=
POSTGRES_DB=bd_gabriela_rincon_nakamoto

# Cadena de conexión completa — también usada por .mcp.json (servidor MCP de Postgres) para
# inspección de esquema/SELECTs. Debe coincidir con POSTGRES_USER/PASSWORD/DB de arriba.
DATABASE_URL=postgresql://sentinel_app:<TU_PASSWORD>@localhost:5434/bd_gabriela_rincon_nakamoto

# Auth
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=
JWT_REFRESH_TOKEN_EXPIRES_DAYS=

# LLM / Embeddings provider
LLM_API_KEY=
EMBEDDING_API_KEY=
