# No incluir secretos reales en este archivo.

# Database
# También usada por .mcp.json (servidor MCP de Postgres) para inspección de esquema/SELECTs.
DATABASE_URL=postgresql://<TU_USUARIO>:<TU_PASSWORD>@localhost:5432/<TU_DB>

# Auth
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=
JWT_REFRESH_TOKEN_EXPIRES_DAYS=

# LLM / Embeddings provider
LLM_API_KEY=
EMBEDDING_API_KEY=
